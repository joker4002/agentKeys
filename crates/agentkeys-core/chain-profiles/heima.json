{
  "name": "heima",
  "display_name": "Heima Network (Litentry mainnet)",
  "chain_id": 212013,
  "chain_kind": "substrate-frontier",
  "rpc": {
    "http": "https://rpc-eth.heima.network",
    "wss": "wss://rpc-eth.heima.network",
    "substrate_wss": "wss://rpc.litentry-parachain.litentry.io"
  },
  "explorer": {
    "url": "https://heima.statescan.io",
