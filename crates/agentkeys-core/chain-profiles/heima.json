    "confirmation_seconds": 6,
    "notes": "Heima parachain uses Polkadot relay-chain GRANDPA finality; ~6s finalization per block, no reorg risk above 1 confirmation."
  },
  "gas": {
    "model": "eip1559",
    "max_priority_fee_gwei": 1,
    "max_fee_gwei": 10
  },
  "deploy": {
    "deployer_env_var": "AGENTKEYS_HEIMA_DEPLOYER_KEY",
    "foundry_chain_arg": "heima"
  }
